{
  "name": "farmfusion",
  "version": "1.0.0",
  "description": "FarmFusion e-commerce platform for seeds and farming tools",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "node scripts/wait-for-api.js && vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "server": "node server/index.js"
  },
  "keywords": [
    "farmfusion",
    "ecommerce",
    "agriculture",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
